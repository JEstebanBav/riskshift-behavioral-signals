# Copia este archivo como ".env" (en la raíz del repo) y pon tus claves.
# El archivo .env está en .gitignore: nunca se sube al repositorio.
# Sin comillas, sin "Bearer" y sin espacios alrededor del "=".

# Modelos de OpenRouter (p. ej. nvidia/nemotron-3.5-super-vl:free)
OPENROUTER_API_KEY=sk-or-v1-pega-aqui-tu-clave

# Modelos de Gemini, directo a Google (p. ej. gemini/gemini-3.5-flash-lite)
GEMINI_API_KEY=pega-aqui-tu-clave

# Opcionales
# LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# LLM_CACHE_DIR=cache/llm
# LLM_MIN_INTERVAL=3.5

# Revisa la configuración sin mostrar las claves:
#   python -m src.llm_monitor --check-key
